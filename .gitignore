# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.lcov
.nyc_output
.vitest/
.jest/

# next.js
/.next/
/out/

# production / build
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# local mock receipt storage (when Supabase Storage is not configured)
.data/

# temporary uploads / OCR scratch
/uploads/
/tmp/
/temp/
*.tmp
*.temp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; example is committed)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example

# vercel / turbo
.vercel
.turbo

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (sqlite local DBs if ever used; keep schema/migrations tracked)
prisma/*.db
prisma/*.db-journal
*.db
*.db-journal

# supabase local
supabase/.branches
supabase/.temp

# inngest local
.inngest/

# graphify local regenerable artifacts (graph.html / cache / reports)
graphify-out/

# IDE / editors (keep shared .vscode settings if added later)
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
