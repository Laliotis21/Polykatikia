# Postgres (Supabase local default shown; replace for hosted)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OCR: mock | document_ai | textract
OCR_PROVIDER=mock

# Anomaly: basis points over trailing 12-mo avg (3000 = 30%)
ANOMALY_MARGIN_BPS=3000

# Resend (admin notify + dunning)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
