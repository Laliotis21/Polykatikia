# Postgres (Supabase local default shown; replace for hosted)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OCR: mock | document_ai | textract
OCR_PROVIDER=mock

# Anomaly: basis points over trailing 12-mo avg (3000 = 30%)
ANOMALY_MARGIN_BPS=3000

# Resend (admin notify + dunning + issuance notices)
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Public app URL for portal links in emails (fallback: request host)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local / hosted demo without a Supabase login session — must match a seeded User email.
# When set on Vercel (Production), dashboard + APIs act as this user even if Supabase keys exist.
# WARNING: anyone who can open the app becomes this operator — demo only, not real multi-tenant auth.
# DEMO_AUTH_EMAIL=admin@polykatoikia.local

# Inngest (serve at /api/inngest; use `npx inngest-cli@latest dev` locally)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
